# Gmail SMTP App Password (16-character password from Google Account -> Security -> 2-Step Verification -> App Passwords)
SMTP_PASSWORD=your_gmail_app_password_here

# Admin Portal Password (https://getknowledge.onrender.com/admin)
ADMIN_PASSWORD=09876543211

# Google Apps Script Email Webhook URL (for Render Free tier email dispatch)
EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

# Port (Render sets this automatically)
PORT=8000
